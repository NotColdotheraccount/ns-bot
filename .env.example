# ---- Telegram ----
TELEGRAM_BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Use the bot's /id command to find these.
ADMIN_TELEGRAM_ID=
GIRLFRIEND_TELEGRAM_ID=
TELEGRAM_GROUP_ID=

# ---- Claude (later stage) ----
CLAUDE_API_KEY=

# ---- Runtime ----
# Local:    sqlite+aiosqlite:///bot.db          (three slashes = relative path)
# Railway:  sqlite+aiosqlite:////data/bot.db    (four slashes = absolute path
#           inside the mounted volume — the bot refuses to start otherwise)
DATABASE_URL=sqlite+aiosqlite:///bot.db
TIMEZONE=Asia/Singapore
LOG_LEVEL=INFO
